0:{"buildId":"VvhG5FFbW5tHFovdEmrgz","rsc":["$","$1","c",{"children":[["$","main",null,{"style":{"padding":"2rem","display":"grid","gap":"1rem","maxWidth":"56rem"},"children":[["$","h1",null,{"children":"How to use"}],["$","div",null,{"style":{"display":"grid","gap":"0.75rem","lineHeight":1.5},"children":[["$","h4","heading-4-0",{"children":["The Most Important Things You Can Do With Who Owns What:"]}],["$","p","paragraph-1",{"children":[""]}],["$","p","paragraph-2",{"children":["Here are a few ways to get the most out of the powerful tool you’re about to use. "]}],["$","p","paragraph-3",{"children":[""]}],["$","h5","heading-5-4",{"children":["Learn more about your building’s issues—and how you may be able to get them fixed. "]}],["$","img","embedded-asset-block-5",{"src":"https://images.ctfassets.net/lhtzm8rjj8y4/2Ivr4g7lSDnFz4D9lCfEUE/9e0665193005bc2be416870e1812ef2f/WOW_English_How_to_use_01.png","alt":"WOW How to Use Visual 1","style":{"maxWidth":"100%"}}],["$","ol","ordered-list-6",{"children":[["$","li","list-item-0",{"children":[["$","p","paragraph-0",{"children":["Check out the violation history for your building. "]}],["$","ol","ordered-list-1",{"children":[["$","li","list-item-0",{"children":[["$","p","paragraph-0",{"children":["Any complaints verified by the Department of Housing Preservation and Development (HPD) inspector (but not yet taken care of) will show up as “Open Violations” in your building’s profile in the “Overview” tab. These violations have different categories - A (non-hazardous), B, (hazardous), and C (immediately hazardous) and you can find more detailed information about these violation classes on the Timeline tab."]}]]}],["$","li","list-item-1",{"children":[["$","p","paragraph-0",{"children":["Use the “Timeline” tab to see a recent history of 311 complaints reported by tenants and official violations issued by HPD. "]}]]}],["$","li","list-item-2",{"children":[["$","p","paragraph-0",{"children":["Dig deeper into the violations by checking out the HPD Building Profile or by going to the Displacement Alert Portal (DAP) from the Association for Neighborhood and Housing Development (ANHD)."]}]]}]]}],["$","p","paragraph-2",{"children":[""]}]]}],["$","li","list-item-1",{"children":[["$","p","paragraph-0",{"children":["See if the number of rent stabilized apartments in your building has changed. "]}],["$","ol","ordered-list-1",{"children":[["$","li","list-item-0",{"children":[["$","p","paragraph-0",{"children":["If there is a decrease in rent stabilized units, there may be illegal deregulation of units, rent overcharges, or potential harassment of tenants occurring. Request your rent history via our ",["$","a","hyperlink-1",{"href":"https://app.justfix.org/en/rh/splash?utm_source=who_owns_what","target":"_blank","rel":"noreferrer","children":[["$","u","text-0,underline-0",{"children":"Online Form"}]]}]," or by texting “RENT HISTORY” to (646) 783-0627 to find out more. "]}]]}]]}]]}]]}],["$","p","paragraph-7",{"children":[""]}],["$","p","paragraph-8",{"children":[""]}],["$","h5","heading-5-9",{"children":["See who else your landlord or property manager may be harming— and determine if it’s possible to build a tenant association (TA). "]}],["$","img","embedded-asset-block-10",{"src":"https://images.ctfassets.net/lhtzm8rjj8y4/5akoKd4rOoR15ticUArlUQ/28a335de5a6b17a6ee7fb676d460ee19/WOW_English_How_to_use_02.png","alt":"WOW How to Use Visual 2","style":{"maxWidth":"100%"}}],["$","ol","ordered-list-11",{"children":[["$","li","list-item-0",{"children":[["$","p","paragraph-0",{"children":["Check the “Complaint History” list in the “HPD Building Profile” for full details on the issues and to see which one of your neighbors is constantly calling 311 with complaints. If you have their contact info, send them their building profile via Facebook, Twitter, email, or text by using the share buttons, or give them an immediate list of actions to take by sharing the “Take Action on JustFix.org” page on the “Overview” tab."]}]]}],"$L2"]}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]}]]}],null,"$L15"]}],"loading":null,"isPartial":false}
2:["$","li","list-item-1",{"children":[["$","p","paragraph-0",{"children":["Use the “Portfolio” tab to see information about other buildings that are associated with your address due to similar management. If other buildings in your landlord’s portfolio also have issues, you may be able to connect with even more tenants like you to build a TA across multiple buildings, and take action together!"]}]]}]
