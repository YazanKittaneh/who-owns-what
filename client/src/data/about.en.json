      },
      {
        "nodeType": "paragraph",
        "data": {},
        "content": [
          {
            "nodeType": "text",
            "value": "This version of Who Owns What is an independent fan-made adaptation inspired by the original project created by JustFix. I built it to preserve and continue the spirit of that work while making my own changes and taking responsibility for how this version is run.",
            "marks": [],
            "data": {}
          }
        ]
      },
      {
        "nodeType": "paragraph",
        "data": {},
        "content": [
          {
            "nodeType": "text",
            "value": "Who Owns What was originally created to help people better understand landlord ownership patterns through public data. This adaptation keeps that core idea alive for Chicago users while giving the project an independent home.",
            "marks": [],
            "data": {}
          }
        ]
      },
      {
        "nodeType": "heading-6",
        "data": {},
        "content": [
          {
            "nodeType": "text",
            "value": "Credit to the original team",
            "marks": [],
            "data": {}
          }
        ]
      },
      {
        "nodeType": "paragraph",
        "data": {},
        "content": [
          {
            "nodeType": "text",
            "value": "The original Who Owns What project was created by JustFix. Their work shaped the idea, purpose, and public value of this tool. This adaptation is a tribute to that work, not an official continuation by JustFix.",
            "marks": [],
            "data": {}
          }
        ]
